# Copy to .env (never commit it). `npm run dev` in Lukas/ also works without this file.
PORT=4200
# Only this computer may call the API. Use 0.0.0.0 to let a phone on your network reach it
# (then also set ROBOT_API_URL to the address of this computer, and the seller API address in the app).
# BIND_HOST=127.0.0.1
# Our own database: MongoDB. `npm run db:memory` starts one without Docker on this port.
MONGODB_URI=mongodb://127.0.0.1:27028/seller

# firebase: real logins (set FIREBASE_PROJECT_ID to the projectId of the Firebase web app)
# dev: local demo without internet. A token looks like "dev:docent@howest.be". Refuses to run in production.
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=
# Only verified Firebase emails get in (default: yes in production, no elsewhere)
# REQUIRE_VERIFIED_EMAIL=true

# Who is an administrator from the start (comma separated). More accounts are added in the panel.
SELLER_ADMIN_EMAILS=docent@howest.be,lukasbohez@gmail.com

# The platform of the companies. In the demo this is the platform simulator.
PLATFORM_URL=http://127.0.0.1:4100
PLATFORM_TOKEN=dev-platform-token
# Where a robot connects with its key. It is sent to the simulator together with the key.
# Default: PLATFORM_URL + /graphql. For a phone use the address of this computer on the network.
# ROBOT_API_URL=http://192.168.1.20:4100/graphql

# Websites that may call this API (comma separated)
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Fill an empty database with demo robots and a demo defect (never in production)
SEED_DEMO=false
