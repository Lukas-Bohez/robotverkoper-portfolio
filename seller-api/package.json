{
  "name": "seller-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "De API van de verkopers van de robots: NestJS, GraphQL en MongoDB. Praat met het platform van de bedrijven via één kleine poort.",
  "scripts": {
    "build": "nest build",
    "cli": "nest build && node dist/cli.js",
    "db:memory": "node scripts/dev-mongo.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "generate:graphql": "nest build && node dist/generate-schema.js",
    "lint": "oxlint --type-aware src/ test/",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dataloader": "^2.2.3",
    "firebase-admin": "^14.5.0",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.2.2",
    "helmet": "^8.3.0",
    "mongodb": "^7.6.0",
    "nestjs-command": "^3.1.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
