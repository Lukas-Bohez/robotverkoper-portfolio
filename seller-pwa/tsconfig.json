{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "vite.config.ts", "pwa.config.ts"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@robotverkoper/seller-types": ["../seller-types/dist/graphql.d.ts"],
      "#build/ui/*": ["./node_modules/.nuxt-ui/ui/*"]
    },
    "noEmit": true
  }
}
