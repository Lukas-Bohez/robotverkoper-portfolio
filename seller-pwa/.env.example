# Copy to Lukas/seller-pwa/.env (never commit .env) and fill in the Firebase values of the
# project (Firebase console > Project settings > your web app). Restart `npm run dev` after a change.
# Without these values `npm run dev` in Lukas/ starts a local demo with dev logins instead.
# The seller API (Lukas/seller-api); `npm run dev` in Lukas/ sets this itself.
VITE_API_URL=http://localhost:4200
VITE_FIREBASE_apiKey=
VITE_FIREBASE_authDomain=
VITE_FIREBASE_projectId=
VITE_FIREBASE_storageBucket=
VITE_FIREBASE_messagingSenderId=
VITE_FIREBASE_appId=
